#!/usr/bin/env bash
# pre-commit: ① 对暂存的 .py 文件执行 ruff format 并重新暂存；② pyproject.toml 变更时，
# 用 pip-compile 重新生成 requirements.txt 并 stage。
#
# 依赖真源是 pyproject.toml；requirements.txt 是只读锁文件（生成产物），uv.lock 不跟踪。
# 缺 pip-compile 时阻止提交；缺 ruff 时也会阻止提交，避免格式化脱节。
# ① 仅暂存了 Python 文件时触发（ruff format 幂等，已格式化则无改动）。
#
# 激活方式（一次性）：
#   git config core.hooksPath scripts/hooks
#
# 跳过方式（临时，会绕过后端校验）：
#   git commit --no-verify

set -e

staged="$(git diff --cached --name-only)"

# ① ruff format：格式化所有暂存的 python 文件（幂等），并重新暂存
py_files="$(printf '%s\n' "$staged" | grep '\.py$' || true)"
if [ -n "$py_files" ]; then
    if ! command -v ruff >/dev/null 2>&1; then
        echo "[pre-commit] 错误：暂存了 Python 文件但未安装 ruff（来自 pyproject dev 组）" >&2
        echo "  请安装：pip install ruff==0.16.4  （或 uv sync --extra dev）" >&2
        echo "  不要用 --no-verify 绕过，CI 会拦截未格式化的提交" >&2
        exit 1
    fi
    printf '%s\n' "$py_files" | xargs ruff format
    printf '%s\n' "$py_files" | xargs git add
    echo "[pre-commit] 已对暂存的 Python 文件执行 ruff format 并重新暂存"
fi

# ② 依赖变更时才重生成 requirements.txt；否则直接结束
if ! printf '%s\n' "$staged" | grep -qE '^pyproject\.toml$'; then
    exit 0
fi

# 缺 pip-compile 则阻止提交（不得让锁文件脱节）
if ! command -v pip-compile >/dev/null 2>&1; then
    echo "[pre-commit] 错误：依赖已变更，但未安装 pip-compile（来自 pip-tools）" >&2
    echo "  请安装：pip install pip-tools==7.6.1  （或 uv sync --extra dev）" >&2
    echo "  不要用 --no-verify 绕过，CI 会拦截未同步的 requirements.txt" >&2
    exit 1
fi

echo "[pre-commit] 检测到依赖文件变更，用 pip-compile 重新生成 requirements.txt ..."

# 生成到临时文件，成功后再替换，避免中途失败把锁文件弄坏
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# 隔离本机 pip 全局配置（镜像/trusted-host），保证锁文件不依赖个人环境、可复现
if ! PIP_CONFIG_FILE=/dev/null pip-compile --no-header --no-emit-index-url --strip-extras --output-file "$tmp" pyproject.toml >/dev/null 2>&1; then
    echo "[pre-commit] 错误：pip-compile 重新生成 requirements.txt 失败" >&2
    exit 1
fi

if [ -f requirements.txt ] && diff -q requirements.txt "$tmp" >/dev/null 2>&1; then
    echo "[pre-commit] requirements.txt 已是最新，无需更新"
    exit 0
fi

mv "$tmp" requirements.txt
git add requirements.txt
echo "[pre-commit] 已重新生成并暂存 requirements.txt"
